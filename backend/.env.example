# Copy this file to `.env` for local development. Never commit `.env`.
# On Azure App Service, set these as Application Settings instead.

PORT=3000
NODE_ENV=development

# PostgreSQL connection string.
# Local example:  postgres://postgres:postgres@localhost:5432/mindmeter
# Azure example:  postgres://<user>:<password>@<server>.postgres.database.azure.com:5432/mindmeter
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mindmeter
# Azure Database for PostgreSQL requires SSL. Set to false only for a local database.
DB_SSL=false

# Comma-separated list of frontend origins allowed to call the API.
# Leave empty in development to allow any origin. MUST be set in production.
# The Next.js frontend runs on port 3001 locally (the API uses 3000), so that is the local origin.
CORS_ORIGIN=http://localhost:3001

# --- Stage 2 NLP (optional). Leave both empty to keep NLP switched off. ---
# The key is used ONLY by this backend. Never put it in the frontend.
OPENROUTER_API_KEY=
# Exact model string from your OpenRouter dashboard (verify it exists and handles Bahasa Indonesia).
OPENROUTER_MODEL=

# --- Demo account (used by `npm run db:seed-demo`) ---
# 16-128 characters: letters, digits, _ or -. The frontend stores the same value in localStorage.
DEMO_ANON_TOKEN=
